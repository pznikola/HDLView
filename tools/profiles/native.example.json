{
  "provider": "native",
  "executables": {
    "yosys": "/path/to/bin/yosys",
    "iverilog": "/path/to/bin/iverilog",
    "vvp": "/path/to/bin/vvp",
    "verilator": "/path/to/bin/verilator",
    "verible-verilog-lint": "/path/to/bin/verible-verilog-lint",
    "python3": "/path/to/matched-python/bin/python3",
    "librelane": "/path/to/librelane"
  },
  "plugins": { "slang": "/path/to/slang.so" },
  "env": { "PATH": "/path/to/bin:/usr/local/bin:/usr/bin:/bin" },
  "pdk_root": "/path/to/pdks",
  "timeout_seconds": 3600
}
