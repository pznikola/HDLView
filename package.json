{
  "name": "hdlview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/frontend-assets.mjs && vite --host 127.0.0.1 --port 1420",
    "build": "node tools/frontend-assets.mjs && tsc --noEmit && vite build",
    "test": "vitest run ui",
    "test:e2e": "playwright test",
    "desktop": "tauri dev",
    "package": "tauri build",
    "lint": "eslint ui vite.config.ts --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "elkjs": "0.11.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@tauri-apps/cli": "2.8.4",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
