{
  "schema_version": 1,
  "name": "VHDL counter",
  "top": "counter",
  "standard": "08",
  "sources": [
    {
      "path": "counter.vhd",
      "language": "vhdl",
      "library": "work"
    }
  ],
  "simulations": {
    "rtl": {
      "simulator": "ghdl",
      "top": "tb",
      "dut_scope": ["tb", "dut"],
      "testbench": ["tb.vhd"],
      "stop_time": "1us"
    },
    "gates": {
      "simulator": "icarus",
      "top": "gate_tb",
      "dut_scope": ["gate_tb", "dut"],
      "testbench": ["gate_tb.sv"],
      "stop_time": "1us"
    },
    "timing": {
      "simulator": "icarus",
      "top": "gate_tb",
      "dut_scope": ["gate_tb", "dut"],
      "testbench": ["gate_tb.sv"],
      "stop_time": "1us",
      "use_snapshot_sdf": true,
      "timing_corner": "nom_typ_1p20V_25C",
      "delay_selection": "max"
    }
  },
  "physical": {
    "pdk": "ihp-sg13g2",
    "library": "sg13g2_stdcell",
    "clock_port": "clk",
    "clock_period_ns": 10
  }
}
